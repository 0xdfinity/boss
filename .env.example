# BOSS — copy to .env and fill. Never commit .env (gitignored).

# Model chain: NEAR AI Cloud first, Groq fallback, deterministic rules last.
# Leave NEAR_AI_MODEL empty to skip NEAR AI and serve every call from Groq.
# Free Groq key: https://console.groq.com/keys
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud.near.ai
NEAR_AI_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Treasury signer. Run `npm run deploy:testnet` to create and deploy on testnet.
NEAR_ACCOUNT=
NEAR_PRIVATE_KEY=
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_NETWORK=testnet
BOSS_TREASURY_CONTRACT_ID=

# Demo exchange rate: 1 USD = 0.1 NEAR when set to 10.
NEAR_USD_RATE=10

# Server
PORT=8787
SITE_URL=http://localhost:8787
